[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/bullet.gd" id="1"]
; 敌我共用同一颗子弹贴图（bullet_player.svg 亮黄细长水滴）。
; 敌弹慢（1040 vs 2400），眼睛凝视得住就显短粗；玩家弹快，视网膜拖尾读成细长。
; Sprite2D 纵向压 0.7 反向补偿这个观感差（缩放加在 Sprite 上不动 Area2D：
; 非均匀缩放若加在会旋转的父节点上，斜向飞行时会被剪切）。
; 碰撞跟随压细（radius 2.1 = 3 x 0.7），判定与观感一致。
[ext_resource type="Texture2D" path="res://assets/bullet_player.svg" id="2"]

; 碰撞 = 水滴外形的内接胶囊（24x6），取代旧红点的 r6 圆；
; CapsuleShape2D 轴向本是 Y，转 90° 让胶囊沿 +X（贴图飞行方向），随整颗子弹一起旋转。
[sub_resource type="CapsuleShape2D" id="CapsuleShape2D_1"]
radius = 2.1
height = 24.0

[node name="EnemyBullet" type="Area2D"]
collision_layer = 16
collision_mask = 3
script = ExtResource("1")

[node name="Sprite2D" type="Sprite2D" parent="."]
texture = ExtResource("2")
scale = Vector2(1, 0.7)

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
rotation = 1.5707964
shape = SubResource("CapsuleShape2D_1")
