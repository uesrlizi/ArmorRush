; Sprite2D 材质 = 加色混合（同玩家曳光弹语言）：磁轨弹=一条亮线，亮天顶格变白兜底。
; 出膛 modulate 由发射方 tracer_tint 整体替换（磁轨炮成员色 (0.95,0.95,0.72) 在黄色族内，
; 敌我共弹语言不重开）；贴图本身白杆+淡黄翼=ADD 源色留提亮余量。
[sub_resource type="CanvasItemMaterial" id="addmat"]
blend_mode = 1

; 碰撞 = 细长杆的内接胶囊（60x6）：磁轨弹全长 48px，胶囊沿 +X 随弹旋转。
[sub_resource type="CapsuleShape2D" id="CapsuleShape2D_1"]
radius = 3.0
height = 60.0

