; Sprite2D 材质 = 加色混合（2026-10-19 用户拍板换上试运行）：三章亮天/雪岭上
; 弹体顶格变白，换恒定明度对比（用户："变白不行吗，意味着总是可读"），
; 与枪口焰/导弹尾焰同一套 ADD 语言；观感不佳删掉本 sub_resource 和
; Sprite2D 上的 material/modulate 行即回普通 alpha 混合（bullet_player.svg 未动）。
[sub_resource type="CanvasItemMaterial" id="addmat"]
blend_mode = 1

; 碰撞 = 水滴外形的内接胶囊（24x6）；CapsuleShape2D 轴向本是 Y，
; 转 90° 让胶囊沿 +X（贴图飞行方向），随整颗子弹一起旋转。
[sub_resource type="CapsuleShape2D" id="CapsuleShape2D_1"]
radius = 3.0
height = 24.0

[node name="PlayerBullet" type="Area2D"]
collision_layer = 8
collision_mask = 5
script = ExtResource("1")

[node name="Sprite2D" type="Sprite2D" parent="."]
material = SubResource("addmat")
; ADD 源色设计（2026-10-19 二轮）：modulate 把贴图 (1, 0.93, 0.35) 压到
; 有效源色 (1, 0.55, 0.15)——导弹尾焰渐变中段=推进焰外橙同档的"火焰橙"。
; ADD 的源色要留提亮余量，近满亮色一加就全线顶格洗白（首批试跑的教训：
; 枪口焰/尾焰/推进焰的源色没有一个近满亮）。预期：暗底显橙黄、三章天顶
; 显暖白、贴地/雪岭顶格变白兜底。要天顶更橙：调低 modulate.g（有效 G=0.933×g）。
modulate = Color(1, 0.59, 0.43, 1)
texture = ExtResource("2")

