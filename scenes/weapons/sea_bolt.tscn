[ext_resource type="Script" path="res://scripts/weapons/bullet.gd" id="1"]
; 沉锚舰炮曳光的直射弹（bullet.gd 纯换皮：语法/速度/伤害由发射方赋值不变）。
; v2=**共享机炮弹画法**（与 enemy_bullet.tscn 同贴图同材质同碰撞）：v1 暗壳
; 曳光矢 60x10 又粗又黑，配白色小迸溅读成「黑色块瞬间消失」（用户判死）——
; 亮底章的弹体可读性归天光承担（v2 压暗后成立），弹体回归全场统一机炮弹。
; fx_sea_bolt.svg 沉淀留档。速度/伤害仍复用 BOSS_SWEEP_*。
[ext_resource type="Texture2D" path="res://assets/common/bullet_player.svg" id="2"]

; Sprite2D 材质 = 加色混合，同 enemy_bullet.tscn。
[sub_resource type="CanvasItemMaterial" id="addmat"]
blend_mode = 1

; 碰撞 = 水滴外形的内接胶囊（24x6），转 90° 让胶囊沿 +X（贴图飞行方向）。
